{
  "name": "vast5-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:wasm": "cargo build --target wasm32-unknown-unknown --release && ~/.cargo/bin/wasm-bindgen --out-dir pkg --target web target/wasm32-unknown-unknown/release/vast5.wasm",
